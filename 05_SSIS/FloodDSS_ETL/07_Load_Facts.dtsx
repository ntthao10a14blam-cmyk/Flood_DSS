            <component
              refId="Package\DFT_Load_Fact_FloodObservation\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    f.Obs_id AS Obs_ID,
    t.TimeKey,
    a.AreaKey,
    l.LocationKey,
    c.CauseKey,
    s.SourceKey,

    TRY_CONVERT(DECIMAL(10,2), f.Water_height_min_cm) AS MinDepth_cm,
    TRY_CONVERT(DECIMAL(10,2), f.Water_height_max_cm) AS MaxDepth_cm,

    CASE
        WHEN f.Water_height_min_cm IS NOT NULL
         AND f.Water_height_max_cm IS NOT NULL
        THEN (
            TRY_CONVERT(DECIMAL(10,2), f.Water_height_min_cm)
            + TRY_CONVERT(DECIMAL(10,2), f.Water_height_max_cm)
        ) / 2.0
        ELSE NULL
    END AS AvgDepth_cm,

    TRY_CONVERT(DECIMAL(10,2), f.Duration_hours) AS Duration_hours,
    f.Depth_class AS DepthClass,
    f.Impact_type AS ImpactType,
    CAST(1 AS TINYINT) AS ObservationCount,

    CASE
        WHEN f.Water_height_min_cm IS NULL
          OR f.Water_height_max_cm IS NULL
        THEN N'Incomplete'
        ELSE N'Valid'
    END AS DataQualityStatus

FROM stg.FloodIntegrated AS f

INNER JOIN dw.Dim_Time AS t
    ON f.Date = t.FullDate

INNER JOIN dw.Dim_Area AS a
    ON TRY_CONVERT(INT, TRY_CONVERT(DECIMAL(18,2), f.Population_Area_ID))
       = TRY_CONVERT(INT, a.Area_ID)
   AND REPLACE(f.Population_BoundaryVersion, 'District_', '') =
       a.BoundaryVersion

INNER JOIN dw.Dim_Location AS l
    ON CONCAT('FID_', f.fid) = l.Location_ID

INNER JOIN dw.Dim_Cause AS c
    ON f.Cause = c.Cause_Name

INNER JOIN dw.Dim_Source AS s
    ON f.Source_id = s.Source_ID

WHERE f.Source_id LIKE N'SRC[_]%'
  AND f.Obs_id IS NOT NULL
  AND LTRIM(RTRIM(f.Obs_id)) &lt;&gt; '';</property>
