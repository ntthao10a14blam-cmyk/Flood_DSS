                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    TRY_CONVERT(INT, p.Area_ID) AS Area_ID,
    REPLACE(p.BoundaryVersion, 'District_', '') AS BoundaryVersion,
    TRY_CONVERT(SMALLINT, 2019) AS [Year],
    p.Population,
    p.Area_km2,
    p.PopulationDensity,
    s.SourceKey,
    N'Valid' AS DataQualityStatus
FROM stg.Population AS p
INNER JOIN dw.Dim_Source AS s
    ON s.Source_ID = N'POP_GPKG_01'
WHERE NOT EXISTS (
    SELECT 1
    FROM dw.Fact_Population AS fp
    INNER JOIN dw.Dim_Area AS a
        ON fp.AreaKey = a.AreaKey
    WHERE TRY_CONVERT(INT, p.Area_ID) = TRY_CONVERT(INT, a.Area_ID)
      AND REPLACE(p.BoundaryVersion, 'District_', '') = a.BoundaryVersion
      AND fp.[Year] = 2019
      AND fp.SourceKey = s.SourceKey
);</property>
