                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH SourceRanked AS (
    SELECT
        LTRIM(RTRIM(Source_id)) AS Source_ID,
        LTRIM(RTRIM(Source_id)) AS Source_Name,
        Source_type AS Source_Type,
        ROW_NUMBER() OVER (
            PARTITION BY LTRIM(RTRIM(Source_id))
            ORDER BY Source_type
        ) AS RowNum
    FROM stg.Flood
    WHERE Source_id IS NOT NULL
      AND LTRIM(RTRIM(Source_id)) &lt;&gt; ''
)
SELECT
    Source_ID,
    Source_Name,
    Source_Type
FROM SourceRanked
WHERE RowNum = 1;</property>
