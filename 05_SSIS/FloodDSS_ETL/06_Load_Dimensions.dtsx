                      name="Location_ID"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\DFT_Load_Dim_Location\SRC_stg_FloodIntegrated.Outputs[OLE DB Source Output].Columns[Location_Name]"
                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\DFT_Load_Dim_Location\SRC_stg_FloodIntegrated.Outputs[OLE DB Source Output].ExternalColumns[Location_Name]"
