          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{771F85D4-8AD1-4490-894E-AE4A9D778405}"
              SQLTask:SqlStatementSource="INSERT INTO dw.ETL_Error&#xA;(&#xA;    Execution_ID,&#xA;    Package_Name,&#xA;    Task_Name,&#xA;    Error_Code,&#xA;    Error_Description,&#xA;    Error_Time&#xA;)&#xA;VALUES&#xA;(&#xA;    CONVERT(UNIQUEIDENTIFIER, ?),&#xA;    ?,&#xA;    ?,&#xA;    ?,&#xA;    ?,&#xA;    SYSDATETIME()&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
