    <DTS:Executable
      DTS:refId="Package\EX_08_Validate_Facts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DD3ABD84-CA82-4FB8-AB42-415027A62FC4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EX_08_Validate_Facts"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{771F85D4-8AD1-4490-894E-AE4A9D778405}"
          SQLTask:SqlStatementSource="USE Flood_DSS;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_Population&#xA;    GROUP BY AreaKey, [Year], SourceKey&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;    THROW 51001, 'Duplicate grain in Fact_Population', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_FloodObservation&#xA;    GROUP BY SourceKey, Obs_ID&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;    THROW 51002, 'Duplicate grain in Fact_FloodObservation', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_FloodObservation f&#xA;    LEFT JOIN dw.Dim_Time d ON f.TimeKey = d.TimeKey&#xA;    WHERE d.TimeKey IS NULL&#xA;)&#xA;    THROW 51003, 'Invalid TimeKey in Fact_FloodObservation', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_FloodObservation f&#xA;    LEFT JOIN dw.Dim_Area d ON f.AreaKey = d.AreaKey&#xA;    WHERE d.AreaKey IS NULL&#xA;)&#xA;    THROW 51004, 'Invalid AreaKey in Fact_FloodObservation', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_FloodObservation f&#xA;    LEFT JOIN dw.Dim_Location d ON f.LocationKey = d.LocationKey&#xA;    WHERE d.LocationKey IS NULL&#xA;)&#xA;    THROW 51005, 'Invalid LocationKey in Fact_FloodObservation', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_FloodObservation f&#xA;    LEFT JOIN dw.Dim_Cause d ON f.CauseKey = d.CauseKey&#xA;    WHERE d.CauseKey IS NULL&#xA;)&#xA;    THROW 51006, 'Invalid CauseKey in Fact_FloodObservation', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_FloodObservation f&#xA;    LEFT JOIN dw.Dim_Source d ON f.SourceKey = d.SourceKey&#xA;    WHERE d.SourceKey IS NULL&#xA;)&#xA;    THROW 51007, 'Invalid SourceKey in Fact_FloodObservation', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_Population f&#xA;    LEFT JOIN dw.Dim_Area d ON f.AreaKey = d.AreaKey&#xA;    WHERE d.AreaKey IS NULL&#xA;)&#xA;    THROW 51008, 'Invalid AreaKey in Fact_Population', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_Population f&#xA;    LEFT JOIN dw.Dim_Source d ON f.SourceKey = d.SourceKey&#xA;    WHERE d.SourceKey IS NULL&#xA;)&#xA;    THROW 51009, 'Invalid SourceKey in Fact_Population', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_FloodObservation&#xA;    WHERE MinDepth_cm &lt; 0&#xA;       OR MaxDepth_cm &lt; 0&#xA;       OR (MinDepth_cm IS NOT NULL&#xA;           AND MaxDepth_cm IS NOT NULL&#xA;           AND MinDepth_cm &gt; MaxDepth_cm)&#xA;       OR (AvgDepth_cm IS NOT NULL&#xA;           AND MinDepth_cm IS NOT NULL&#xA;           AND MaxDepth_cm IS NOT NULL&#xA;           AND (AvgDepth_cm &lt; MinDepth_cm OR AvgDepth_cm &gt; MaxDepth_cm))&#xA;       OR Duration_hours &lt; 0&#xA;       OR ObservationCount &lt;&gt; 1&#xA;)&#xA;    THROW 51010, 'Invalid measures in Fact_FloodObservation', 1;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.Fact_Population&#xA;    WHERE Population &lt; 0&#xA;       OR (Area_km2 IS NOT NULL AND Area_km2 &lt;= 0)&#xA;       OR PopulationDensity &lt; 0&#xA;)&#xA;    THROW 51011, 'Invalid measures in Fact_Population', 1;&#xA;&#xA;PRINT 'TV5 VALIDATION PASSED';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EX_09_Success_Log"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2B9B9CB8-0A99-4CBC-BA0A-F17F4C4F15FE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="EX_09_Success_Log"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{771F85D4-8AD1-4490-894E-AE4A9D778405}"
          SQLTask:SqlStatementSource="UPDATE dw.ETL_Log&#xA;SET&#xA;    End_Time = SYSDATETIME(),&#xA;    Execution_Status = N'Success',&#xA;    Rows_Processed =&#xA;        (SELECT COUNT_BIG(*) FROM dw.Fact_FloodObservation)&#xA;        + (SELECT COUNT_BIG(*) FROM dw.Fact_Population),&#xA;    Rows_Error =&#xA;        (SELECT COUNT_BIG(*)&#xA;         FROM dw.ETL_Error&#xA;         WHERE Execution_ID = CONVERT(UNIQUEIDENTIFIER, ?))&#xA;WHERE Execution_ID = CONVERT(UNIQUEIDENTIFIER, ?);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::ExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="36" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::ExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="36" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
