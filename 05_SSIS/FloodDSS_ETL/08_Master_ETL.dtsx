          SQLTask:Connection="{DF4163EC-6363-4D66-A17B-76B4121E9E4A}"
          SQLTask:SqlStatementSource="DECLARE @ExecutionID UNIQUEIDENTIFIER = NEWID();&#xA;&#xA;INSERT INTO stg.ETL_Log&#xA;(&#xA;    BatchID,&#xA;    PackageName,&#xA;    StartTime,&#xA;    ExecutionStatus&#xA;)&#xA;VALUES&#xA;(&#xA;    @ExecutionID,&#xA;    N'08_Master_ETL',&#xA;    SYSDATETIME(),&#xA;    N'Running'&#xA;);&#xA;&#xA;SELECT CONVERT(NVARCHAR(36), @ExecutionID) AS ExecutionID;"
